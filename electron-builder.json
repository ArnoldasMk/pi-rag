{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "dev.pirag.app",
  "productName": "Pi RAG",
  "executableName": "pi-rag",
  "artifactName": "pi-rag-${version}-${os}-${arch}.${ext}",
  "asar": true,
  "asarUnpack": [
    "node_modules/@ff-labs/**",
    "node_modules/ffi-rs/**",
    "node_modules/@yuuang/**",
    "node_modules/@lydell/**",
    "node_modules/koffi/**"
  ],
  "npmRebuild": false,
  "directories": {
    "output": "release/${version}"
  },
  "files": ["out"],
  "extraResources": [
    {
      "from": "icons",
      "to": "icons"
    },
    {
      "from": "CHANGELOG.md",
      "to": "CHANGELOG.md"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "icons/icon.icns",
    "target": ["dmg"]
  },
  "linux": {
    "category": "Development",
    "icon": "icons/icon.png",
    "maintainer": "Pi RAG contributors",
    "target": ["AppImage", "deb", "tar.gz"]
  },
  "win": {
    "icon": "icons/icon.ico",
    "target": ["nsis"]
  },
  "publish": {
    "provider": "github",
    "owner": "ArnoldasMk",
    "repo": "pi-rag",
    "releaseType": "release"
  }
}
